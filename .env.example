# EmailJS, for the contact form. Copy to .env.local (gitignored) and fill in
# real values. Server-only: read by sendMessage in app/actions.ts and never
# sent to the browser. Requires "Allow EmailJS API for non-browser
# applications" under Account → Security.
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
